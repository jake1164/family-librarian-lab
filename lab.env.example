# Copy this file to lab.env. lab.env is gitignored and may contain only
# machine-local credentials and source paths.

# se-lab's optional AI settings are intentionally left unset for this lifecycle
# slice. Add the LAB_* settings from se-lab/lab.env.example only when using AI
# commands.

# Absolute path to a checked-out Family Librarian source tree used to build the
# image under test. It is deliberately not the production deployment.
FAMILY_LIBRARIAN_SOURCE_DIR=/absolute/path/to/family-librarian
FAMILY_LIBRARIAN_PROJECT_NAME=family-librarian-lab
FAMILY_LIBRARIAN_HOST_PORT=18080

# Deliberately pinned dependency images copied from Family Librarian's Compose
# deployment. Update only with a recorded green compatibility run.
FAMILY_LIBRARIAN_POSTGRES_IMAGE=postgres:17.6-alpine
FAMILY_LIBRARIAN_CLAMAV_IMAGE=clamav/clamav:1.4
FAMILY_LIBRARIAN_IMAGE=family-librarian-lab:dev

# Test-only bootstrap credentials. Do not reuse household or production values.
FAMILY_LIBRARIAN_POSTGRES_PASSWORD=replace-with-a-test-only-password
FAMILY_LIBRARIAN_ADMIN_EMAIL=admin@example.test
FAMILY_LIBRARIAN_ADMIN_PASSWORD=replace-with-a-test-only-password

# Optional metadata settings. Empty/default values avoid external provider use.
FAMILY_LIBRARIAN_OPENLIBRARY_CONTACT_EMAIL=
FAMILY_LIBRARIAN_OPENLIBRARY_REQUESTS_PER_SECOND=1
FAMILY_LIBRARIAN_GOOGLE_BOOKS_ENABLED=false
FAMILY_LIBRARIAN_GOOGLE_BOOKS_API_KEY=
FAMILY_LIBRARIAN_INVITATIONS_LIFETIME_DAYS=7
FAMILY_LIBRARIAN_INVITATIONS_REDEMPTION_ATTEMPTS_PER_MINUTE=10
