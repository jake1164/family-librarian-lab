# Copy this file to lab.env. lab.env is gitignored and may contain only
# machine-local credentials and source paths.

# se-lab's optional AI settings are intentionally left unset for this lifecycle
# slice. Add the LAB_* settings from se-lab/lab.env.example only when using AI
# commands.

# The lab is self-contained: `build`/`up`/`run` check Family Librarian's source
# out to repos/family-librarian themselves (mirroring m3undle-lab-public), so
# FAMILY_LIBRARIAN_SOURCE_DIR is no longer a setting -- there is nothing to
# point at a separate checkout. FAMILY_LIBRARIAN_REPO_URL is optional: the
# plugin defaults it to the real upstream repo.
# FAMILY_LIBRARIAN_REPO_URL=git@github.com:jake1164/family-librarian.git

# The lab's standard Compose project name (agent.common.project_name()) is
# used automatically -- FAMILY_LIBRARIAN_PROJECT_NAME is no longer required.
# Set it only to override that default.
# FAMILY_LIBRARIAN_PROJECT_NAME=family-librarian-lab
FAMILY_LIBRARIAN_HOST_PORT=18080
# Generic se-lab hosted-link setting (also applies to every other product lab).
# It changes only the URLs printed for manual testing, not local health probes.
# LAB_EXTERNAL_HOST=toontown-int-srv2

# Deliberately pinned dependency images copied from Family Librarian's Compose
# deployment. Update only with a recorded green compatibility run.
FAMILY_LIBRARIAN_POSTGRES_IMAGE=postgres:17.6-alpine
FAMILY_LIBRARIAN_CLAMAV_IMAGE=clamav/clamav:1.4
FAMILY_LIBRARIAN_IMAGE=family-librarian-lab:dev

# cwa-local/abs profiles: `./lab up --profile cwa-local`/`--profile abs`, or
# `./lab run --test-group cwa-local`/`--test-group abs`, bring these up and wire Family
# Librarian to point at them automatically -- no manual setup needed either
# way. Pinned images, overridable per client-app image conventions elsewhere
# in this project.
# FAMILY_LIBRARIAN_CWA_IMAGE=crocodilestick/calibre-web-automated:latest
# FAMILY_LIBRARIAN_CWA_HOST_PORT=18083
# FAMILY_LIBRARIAN_ABS_IMAGE=advplyr/audiobookshelf:latest
# FAMILY_LIBRARIAN_ABS_HOST_PORT=18378

# cwa-local also folds in Kindle/e-reader delivery testing -- no separate
# profile: a disposable Mailpit relay (CWA's own, distinct from the `smtp`
# profile's), a CWA e-reader service account, and two seeded readers
# (reader1@sydneyelvis.net / reader2@sydneyelvis.net, both password
# family-librarian-lab-reader-only) each with a Kindle delivery target are all
# configured automatically. Set these two ONLY if you want a seeded reader's
# Kindle target to point at a real, personal Send-to-Kindle address you've
# added to Amazon's Approved Personal Document Email list -- left unset, both
# readers get fake addresses that only ever reach the local Mailpit relay, so
# automated runs never touch a real device. Do not commit real values here.
# FAMILY_LIBRARIAN_READER1_KINDLE_EMAIL=
# FAMILY_LIBRARIAN_READER2_KINDLE_EMAIL=
# FAMILY_LIBRARIAN_CWA_MAILPIT_HOST_PORT=18029

# cwa-sftp-key/cwa-sftp-password profiles: `./lab up --profile cwa-sftp-key`
# (or `--profile cwa-sftp-password`), or `./lab run --test-group cwa-sftp-key`/
# `--test-group cwa-sftp-password`, bring up an atmoz/sftp sidecar in front of the
# same `cwa` service as cwa-local and wire Family Librarian to it over SFTP --
# no manual setup needed either way. FAMILY_LIBRARIAN_SFTP_KEY_DIR is set
# automatically (a disposable host-local test keypair generated under
# runtime/); FAMILY_LIBRARIAN_SFTP_PASSWORD defaults to a fixed test-only
# value. Set either only to override those defaults.
# FAMILY_LIBRARIAN_SFTP_IMAGE=atmoz/sftp:alpine
# FAMILY_LIBRARIAN_SFTP_PASSWORD=replace-with-a-test-only-password

# smtp profile: `./lab up --profile smtp`, or `./lab run --test-group smtp`,
# bring up a real disposable Mailpit SMTP catcher -- unlike cwa-local/abs,
# Family Librarian's SMTP settings are NOT pre-configured (SMTP configuration
# is the thing each case exercises directly). SMTP AUTH credentials are fixed
# (docker/mailpit/smtp-auth-file); nothing to set here for them.
# FAMILY_LIBRARIAN_MAILPIT_IMAGE=axllent/mailpit:latest
# FAMILY_LIBRARIAN_SMTP_HOST_PORT=18025

# Test-only bootstrap credentials. Do not reuse household or production values.
FAMILY_LIBRARIAN_POSTGRES_PASSWORD=replace-with-a-test-only-password
FAMILY_LIBRARIAN_ADMIN_EMAIL=admin@example.test
FAMILY_LIBRARIAN_ADMIN_PASSWORD=replace-with-a-test-only-password

# Optional metadata settings. Empty/default values avoid external provider use.
FAMILY_LIBRARIAN_OPENLIBRARY_CONTACT_EMAIL=
FAMILY_LIBRARIAN_OPENLIBRARY_REQUESTS_PER_SECOND=1
FAMILY_LIBRARIAN_GOOGLE_BOOKS_ENABLED=false
FAMILY_LIBRARIAN_GOOGLE_BOOKS_API_KEY=
FAMILY_LIBRARIAN_INVITATIONS_LIFETIME_DAYS=7
FAMILY_LIBRARIAN_INVITATIONS_REDEMPTION_ATTEMPTS_PER_MINUTE=10
